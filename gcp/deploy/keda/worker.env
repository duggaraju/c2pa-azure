# Settings for keda-worker on GKE, passed to the worker as environment
# variables. Keep comments on their own lines.

# Bucket the worker drains and the bucket for signed files.
INPUT_BUCKET=<input-bucket>
OUTPUT_BUCKET=<output-bucket>

# Cloud KMS key version and the certificate chain issued for it (mounted from
# the c2pa-certificate-chain secret).
KMS_KEY_NAME=projects/<project-id>/locations/<location>/keyRings/<key-ring>/cryptoKeys/<key>/cryptoKeyVersions/1
CERTIFICATE_CHAIN=/etc/c2pa/chain.pem
TIME_AUTHORITY_URL=http://timestamp.digicert.com
