# Settings for keda-worker on AKS, passed to the worker as environment
# variables. Keep comments on their own lines.

# Storage account with the input and output containers (common.bicepparam).
STORAGE_ACCOUNT=c2paacsmediastorage
INPUT_CONTAINER=input
OUTPUT_CONTAINER=output

# Trusted Signing account (the signingEndpoint output of aks.bicep) and
# certificate profile.
SIGNING_ENDPOINT=https://eus.codesigning.azure.net/
SIGNING_ACCOUNT=c2paacscodesigning
CERTIFICATE_PROFILE=media-provenance-sign

# Client id of the worker identity (the workerClientId output of aks.bicep).
# The worker and the KEDA scaler both authenticate as this identity.
AZURE_CLIENT_ID=<worker-client-id>
