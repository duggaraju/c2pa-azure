# Settings for keda-worker on EKS, passed to the worker as environment
# variables. Keep comments on their own lines.

# SQS queue receiving the input bucket's s3:ObjectCreated:* notifications, and
# the bucket for signed files.
QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<input-queue>
OUTPUT_BUCKET=<output-bucket>
AWS_REGION=<region>

# IAM role of the worker. KEDA assumes the same role to read the queue.
AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<c2pa-worker-role>

# KMS signing key and the certificate chain issued for it (mounted from the
# c2pa-certificate-chain secret).
KMS_KEY_ID=arn:aws:kms:<region>:<account-id>:key/<key-id>
ALGORITHM=ps384
CERTIFICATE_CHAIN=/etc/c2pa/chain.pem
TIME_AUTHORITY_URL=http://timestamp.digicert.com
